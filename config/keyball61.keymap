#define DEFAULT 0
#define SYM     1
#define FUN     2
#define MOUSE   3
#define SCROLL  4
#define SNIPE   5

#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp ESC    &kp N1   &kp N2    &kp N3         &kp N4  &kp N5                                   &kp N6     &kp N7  &kp N8     &kp N9   &kp N0   &kp MINUS   
&kp TAB    &kp Q    &kp W     &kp E   &kp R   &kp T                                 &kp Y      &kp U   &kp I      &kp O    &kp P    &kp LBKT
&mo SCROLL &kp A    &kp S     &kp D   &kp F   &kp G                                 &kp H      &kp J   &kp K      &kp L    &kp SEMI &kp SQT
&kp LSHFT  &kp Z    &kp X     &kp C   &kp V   &kp B     &kp PAGE_DOWN  &kp PAGE_UP  &kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH &kp RIGHT_SHIFT
&kp LCTRL  &kp LWIN &kp LALT  &mo FUN &mo FUN &kp SPACE &mo SCROLL     &kp ENTER    &kp LANG2                              &kp INT1 &mo MOUSE
            >;
        };

        number_layer {
            bindings = <
&trans  &kp N1    &kp N2    &kp N3  &kp N4     &kp N5                  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &trans    &trans    &trans  &trans     &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans    &trans    &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans    &trans    &trans  &trans     &trans  &trans  &trans  &trans                          &trans  &trans
            >;

            label = "NUM";
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT                  &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &trans           &trans        &trans        &trans        &trans                       &trans          &trans         &trans            &trans                &trans                 &trans
&trans  &bt BT_CLR       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans                       &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &trans                 &trans
&trans  &trans           &trans        &trans        &trans        &trans       &trans  &trans  &kp UNDERSCORE  &kp PLUS       &trans            &trans                &trans                 &trans
&trans  &trans           &trans        &trans        &trans        &trans       &trans  &trans  &trans                                                                 &trans                 &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&kp  &kp F1         &kp F2           &kp F3        &kp F4            &kp F5                         &kp F6   &kp F7  &kp F8   &kp F9    &kp F10  &kp EQUAL
&trans  &kp LC(LS(N1)) &kp LC(LG(LEFT)) &kp UP        &kp LC(LG(RIGHT)) &trans                         &trans   &kp INS &kp HOME &kp PG_UP &kp F11  &kp RBKT
&trans  &kp DEL        &kp LEFT         &kp DOWN      &kp RIGHT         &trans                         &kp BSPC &kp DEL &kp END  &kp PG_DN &kp F12  &kp NUHS
&trans  &kp K_APP      &kp LA(F4)       &kp LC(LA(A)) &kp LC(LA(V))     &trans  &trans  &trans         &trans   &trans  &trans   &trans    &kp INT1 &trans
&trans  &trans         &trans           &trans        &trans            &trans  &trans  &kp INT_HENKAN &kp LANG1                           &kp BSLH &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans    &trans    &trans  &trans     &trans                  &trans         &trans         &trans    &trans         &trans          &trans
&trans  &trans    &trans    &trans  &trans     &trans                  &trans         &msc SCRL_LEFT &mkp MB3  &msc SCRL_UP   &msc SCRL_RIGHT &trans
&trans  &trans    &trans    &trans  &trans     &trans                  &mkp MB4       &mkp MB1       &mkp MB2  &msc SCRL_DOWN &mkp MB5        &trans
&trans  &trans    &trans    &trans  &trans     &trans  &trans  &trans  &kp PAGE_DOWN  &kp LEFT       &mo 5     &kp RIGHT      &trans          &trans
&trans  &trans    &trans    &trans  &trans     &trans  &trans  &trans  &mo 3                                                  &trans          &trans
            >;
        };

        scroll_layer {
            label = "SCRNUM";
            bindings = <
&trans       &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_SEL 5            &kp KP_NUM &kp KP_N7 &kp KP_N8 &kp KP_N9  &kp KP_SLASH &kp KP_ASTERISK
&bt BT_CLR   &trans       &trans       &trans       &trans       &trans                  &trans     &kp KP_N4 &kp KP_N5 &kp KP_N6  &kp KP_MINUS &trans
&trans       &trans       &trans       &trans       &trans       &trans                  &kp BSPC   &kp KP_N1 &kp KP_N2 &kp KP_N3  &kp KP_PLUS  &kp SQT
&trans       &trans       &trans       &trans       &trans       &trans  &trans  &trans  &trans     &kp KP_N0 &trans    &kp KP_DOT &kp KP_ENTER &trans
&trans       &trans       &trans       &trans       &trans       &trans  &trans  &trans  &trans                                    &trans       &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans
            >;
        };
    };
};
